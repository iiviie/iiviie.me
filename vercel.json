{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "includeFiles": [
    "src/posts/**",
    "src/projects/**"
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
} 